#!/usr/bin/env bash
#
# commit-msg hook
#   1. 브랜치 이름(<type>/#<이슈번호>-<설명>)에서 이슈 번호를 찾아
#      커밋 제목 끝에 (#이슈번호) 가 없으면 자동으로 붙입니다.
#   2. 커밋 제목이 <type>: <subject> (#이슈번호) 형식인지 검사합니다.
#
# 건너뛰기: git commit --no-verify  또는  SKIP_HOOKS=1 git commit ...

set -euo pipefail

[[ "${SKIP_HOOKS:-0}" == "1" ]] && exit 0

MSG_FILE="$1"
TYPES="feat|fix|refactor|style|design|test|docs|chore|ci|rename|remove"

if [[ -t 1 ]]; then RED=$'\033[31m'; GREEN=$'\033[32m'; RESET=$'\033[0m'; else RED=""; GREEN=""; RESET=""; fi

# 주석(#로 시작하는 줄)과 빈 줄을 제외한 첫 줄이 커밋 제목
SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1 || true)"
[[ -z "$SUBJECT" ]] && exit 0   # 빈 메시지는 git 이 알아서 중단

# git 이 자동으로 만드는 메시지는 검사하지 않음
if [[ "$SUBJECT" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
  exit 0
fi

# 1. 이슈 번호 자동 추가 (브랜치에 이슈 번호가 있고, 제목에 없을 때)
NEW_SUBJECT="$SUBJECT"
BRANCH="$(git branch --show-current 2>/dev/null || true)"
if [[ "$BRANCH" =~ ^[a-z]+/#([0-9]+)- ]]; then
  ISSUE="${BASH_REMATCH[1]}"
  if [[ ! "$SUBJECT" =~ \(#[0-9]+\)$ ]]; then
    NEW_SUBJECT="$SUBJECT (#$ISSUE)"
  fi
fi

# 2. 형식 검사
PATTERN="^($TYPES): .+ \(#[0-9]+\)$"
if [[ "$NEW_SUBJECT" =~ $PATTERN ]]; then
  if [[ "$NEW_SUBJECT" != "$SUBJECT" ]]; then
    TMP="$(mktemp)"
    # 제목 줄(첫 번째로 나오는 해당 줄)만 교체
    awk -v old="$SUBJECT" -v new="$NEW_SUBJECT" '!done && $0 == old { print new; done = 1; next } { print }' \
      "$MSG_FILE" > "$TMP"
    cat "$TMP" > "$MSG_FILE"
    rm -f "$TMP"
    echo "${GREEN}✓${RESET} 커밋 제목에 이슈 번호를 붙였습니다: $NEW_SUBJECT"
  fi
else
  cat >&2 <<EOF
${RED}✗ 커밋 메시지가 컨벤션과 다릅니다.${RESET}

  입력: $SUBJECT

  형식: <type>: <subject> (#이슈번호)
  예시: feat: 로그인 화면 UI 구현 (#12)
  type: ${TYPES//|/, }

  - 브랜치가 <type>/#<이슈번호>-<설명> 형식이면 (#이슈번호) 는 자동으로 붙습니다.
  - 작성한 메시지는 .git/COMMIT_EDITMSG 에 남아 있습니다.
    다시 커밋: git commit -e -F .git/COMMIT_EDITMSG
  - 정말 건너뛰어야 한다면: git commit --no-verify
EOF
  exit 1
fi
